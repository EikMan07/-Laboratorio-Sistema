# Entorno
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (Supabase - usar Connection Pooler con SSL)
DATABASE_URL=
# Opcional: certificado CA de Supabase (PEM o base64) para activar rejectUnauthorized: true
DB_SSL_CA=

# Orígenes permitidos por CORS (URL de Vercel en producción, sin barra final)
CORS_ORIGIN=http://localhost:5173

# Criptografía (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=v1
# Opcional para rotación de llaves (llave anterior en base64):
DATA_ENCRYPTION_KEY_PREV=
DATA_ENCRYPTION_KEY_PREV_VERSION=v0

# Firma de sesiones JWT, bitácora HMAC y token anti-CSRF (mínimo 32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRES_IN=25m
HMAC_SECRET=
# Opcional: si se omite, el servidor respalda la firma CSRF con HMAC_SECRET
CSRF_SECRET=

# Cookie cross-site en producción ("none" para Vercel + Render en dominios distintos, "lax" en mismo sitio)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
